rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // HERKES (giriş yapmış) OKUYABİLİR — herkes birbirinin puantajını görebilir
    // ama herkes SADECE KENDİ verisine yazabilir
    match /kullanicilar/{kullaniciId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == kullaniciId;

      match /{altKoleksiyon=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == kullaniciId;
      }
    }

    // ═══ MUTABAKAT — işveren onayı ═══
    // İşçi ay sonunda bağlantı üretir, işveren HESAP AÇMADAN onaylar.
    match /mutabakat/{anahtar} {

      // Yalnızca onay alanlarının değiştiğini doğrular
      function sadeceOnay() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['onay','onayTarih','onaylayanAd','onaylayanNot']);
      }

      // get = tek belge (bağlantıyı bilen görebilir)
      // list = koleksiyon listeleme KAPALI (yoksa herkes tüm kayıtları döker)
      allow get: if true;
      allow list: if false;

      // Oluşturma: yalnızca giriş yapmış işçi, kendi kimliğiyle
      allow create: if request.auth != null
                    && request.resource.data.sahipId == request.auth.uid;

      // Güncelleme: işveren yalnızca onay alanlarını, YALNIZCA BİR KEZ.
      // Onay verildikten sonra iptal edilemez, adı değiştirilemez.
      allow update: if (sadeceOnay() && resource.data.onay == false)
                    || (request.auth != null && resource.data.sahipId == request.auth.uid);

      // Silme yalnızca sahibinde
      allow delete: if request.auth != null && resource.data.sahipId == request.auth.uid;
    }
  }
}
