rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0.1.4.2: PIN özeti diğer kullanıcı verilerinden TAMAMEN AYRI bir kasada.
    // Alt koleksiyonların genel okuma kurallarına ASLA dahil değil.
    // PIN'in 6 hanesi ASLA düz metin olarak saklanmaz.
    match /pinKasasi/{uid} {
      allow get, list, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version','salt','hash','iterations','updatedAt'])
        && request.resource.data.version == 2
        && request.resource.data.salt is string
        && request.resource.data.hash is string
        && request.resource.data.iterations is int
        && request.resource.data.iterations >= 100000
        && request.resource.data.iterations <= 1000000;
    }

    // HERKES (giriş yapmış) OKUYABİLİR — herkes birbirinin puantajını görebilir
    // ama herkes SADECE KENDİ verisine yazabilir
    match /kullanicilar/{kullaniciId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == kullaniciId;

      match /{altKoleksiyon=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == kullaniciId;
      }
    }

    // ═══ MUTABAKAT — işveren onayı ═══
    // İşçi ay sonunda bağlantı üretir, işveren HESAP AÇMADAN onaylar.
    match /mutabakat/{anahtar} {

      // Yalnızca onay alanlarının değiştiğini doğrular
      function sadeceOnay() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['onay','onayTarih','onaylayanAd','onaylayanNot']);
      }

      // get = tek belge (bağlantıyı bilen görebilir)
      // list = koleksiyon listeleme KAPALI (yoksa herkes tüm kayıtları döker)
      allow get: if true;
      allow list: if false;

      // Oluşturma: yalnızca giriş yapmış işçi, kendi kimliğiyle
      allow create: if request.auth != null
                    && request.resource.data.sahipId == request.auth.uid;

      // Güncelleme: işveren yalnızca onay alanlarını, YALNIZCA BİR KEZ.
      // Onay verildikten sonra iptal edilemez, adı değiştirilemez.
      allow update: if (sadeceOnay() && resource.data.onay == false)
                    || (request.auth != null && resource.data.sahipId == request.auth.uid);

      // Silme yalnızca sahibinde
      allow delete: if request.auth != null && resource.data.sahipId == request.auth.uid;
    }

    // ═══ YOKLAMA — patron günlük yoklaması (0.1.6.1) ═══
    // İşçi bir gün için bağlantı üretir; patron HESAP AÇMADAN işaretler.
    // Mutabakattan FARKI: patron cevap verdikten sonra işçi belgeyi HİÇ değiştiremez/silemez.
    match /yoklama/{anahtar} {

      // Yalnızca patron alanlarının değiştiğini doğrular
      function sadecePatron() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['patronCevap','patronDurum','patronNot','patronAd','patronTarih']);
      }
      // Cevap gelmeden işçinin yenileyebildiği alanlar (işçi kaydının anlık görüntüsü)
      function sadeceIsci() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['durum','mesaiYev','mesai','not','santiye','guncelleme']);
      }

      // get = bağlantıyı bilen görür; list KAPALI
      allow get: if true;
      allow list: if false;

      // Oluşturma: yalnızca giriş yapmış işçi, kendi kimliğiyle, cevapsız olarak
      allow create: if request.auth != null
                    && request.resource.data.sahipId == request.auth.uid
                    && request.resource.data.patronCevap == false;

      allow update: if (
                         // PATRON: yalnızca cevap alanları, YALNIZCA BİR KEZ
                         resource.data.patronCevap == false
                         && sadecePatron()
                         && request.resource.data.patronCevap == true
                         && request.resource.data.patronDurum in ['tam','yarim','gelmedi']
                         && request.resource.data.patronAd is string
                         && request.resource.data.patronAd.size() >= 2
                         && request.resource.data.patronAd.size() <= 60
                         && request.resource.data.patronNot is string
                         && request.resource.data.patronNot.size() <= 200
                         && request.resource.data.patronTarih == request.time
                       ) || (
                         // İŞÇİ: yalnızca cevap GELMEDEN ve yalnızca kendi alanlarını
                         request.auth != null
                         && resource.data.sahipId == request.auth.uid
                         && resource.data.patronCevap == false
                         && sadeceIsci()
                       );

      // Silme: yalnızca sahibi ve yalnızca cevap gelmeden (patron cevabı silinemez)
      allow delete: if request.auth != null
                    && resource.data.sahipId == request.auth.uid
                    && resource.data.patronCevap == false;
    }
  }
}
