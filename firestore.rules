rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0.1.4.2: PIN özeti diğer kullanıcı verilerinden TAMAMEN AYRI bir kasada.
    // Alt koleksiyonların genel okuma kurallarına ASLA dahil değil.
    // PIN'in 6 hanesi ASLA düz metin olarak saklanmaz.
    match /pinKasasi/{uid} {
      allow get, list, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['version','salt','hash','iterations','updatedAt'])
        && request.resource.data.version == 2
        && request.resource.data.salt is string
        && request.resource.data.hash is string
        && request.resource.data.iterations is int
        && request.resource.data.iterations >= 100000
        && request.resource.data.iterations <= 1000000;
    }

    // HERKES (giriş yapmış) OKUYABİLİR — herkes birbirinin puantajını görebilir
    // ama herkes SADECE KENDİ verisine yazabilir
    match /kullanicilar/{kullaniciId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == kullaniciId;

      match /{altKoleksiyon=**} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == kullaniciId;
      }
    }

    // ═══ MUTABAKAT — işveren onayı ═══
    // İşçi ay sonunda bağlantı üretir, işveren HESAP AÇMADAN onaylar.
    match /mutabakat/{anahtar} {

      // Yalnızca onay alanlarının değiştiğini doğrular
      function sadeceOnay() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['onay','onayTarih','onaylayanAd','onaylayanNot']);
      }

      // get = tek belge (bağlantıyı bilen görebilir)
      // list = koleksiyon listeleme KAPALI (yoksa herkes tüm kayıtları döker)
      allow get: if true;
      allow list: if false;

      // Oluşturma: yalnızca giriş yapmış işçi, kendi kimliğiyle
      allow create: if request.auth != null
                    && request.resource.data.sahipId == request.auth.uid;

      // Güncelleme: işveren yalnızca onay alanlarını, YALNIZCA BİR KEZ.
      // Onay verildikten sonra iptal edilemez, adı değiştirilemez.
      allow update: if (sadeceOnay() && resource.data.onay == false)
                    || (request.auth != null && resource.data.sahipId == request.auth.uid);

      // Silme yalnızca sahibinde
      allow delete: if request.auth != null && resource.data.sahipId == request.auth.uid;
    }

    // ═══ YOKLAMA — patron günlük yoklaması (0.1.6.1) ═══
    // İşçi bir gün için bağlantı üretir; patron HESAP AÇMADAN işaretler.
    // Mutabakattan FARKI: patron cevap verdikten sonra işçi belgeyi HİÇ değiştiremez/silemez.
    match /yoklama/{anahtar} {

      // Yalnızca patron alanlarının değiştiğini doğrular
      function sadecePatron() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['patronCevap','patronDurum','patronNot','patronAd','patronTarih']);
      }
      // Cevap gelmeden işçinin yenileyebildiği alanlar (işçi kaydının anlık görüntüsü)
      function sadeceIsci() {
        return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['durum','mesaiYev','mesai','not','santiye','guncelleme']);
      }

      // get = bağlantıyı bilen görür; list KAPALI
      allow get: if true;
      allow list: if false;

      // Oluşturma: yalnızca giriş yapmış işçi, kendi kimliğiyle, cevapsız olarak
      allow create: if request.auth != null
                    && request.resource.data.sahipId == request.auth.uid
                    && request.resource.data.patronCevap == false;

      allow update: if (
                         // PATRON: yalnızca cevap alanları, YALNIZCA BİR KEZ
                         resource.data.patronCevap == false
                         && sadecePatron()
                         && request.resource.data.patronCevap == true
                         && request.resource.data.patronDurum in ['tam','yarim','gelmedi']
                         && request.resource.data.patronAd is string
                         && request.resource.data.patronAd.size() >= 2
                         && request.resource.data.patronAd.size() <= 60
                         && request.resource.data.patronNot is string
                         && request.resource.data.patronNot.size() <= 200
                         && request.resource.data.patronTarih == request.time
                       ) || (
                         // İŞÇİ: yalnızca cevap GELMEDEN ve yalnızca kendi alanlarını
                         request.auth != null
                         && resource.data.sahipId == request.auth.uid
                         && resource.data.patronCevap == false
                         && sadeceIsci()
                       );

      // Silme: yalnızca sahibi ve yalnızca cevap gelmeden (patron cevabı silinemez)
      allow delete: if request.auth != null
                    && resource.data.sahipId == request.auth.uid
                    && resource.data.patronCevap == false;
    }

    // ═══ HESABIM — kişisel hesap kartı (0.1.6.2) ═══
    // Hesap numarası kayıt defteri: numarayı bilen ADI (kısaltılmış) görür; liste KAPALI; başkasına devredilemez.
    match /hesapNo/{no} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
                    && no.matches('[1-9][0-9]{7}')
                    && request.resource.data.keys().hasOnly(['uid','ad'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.ad is string
                    && request.resource.data.ad.size() <= 40;
      allow update, delete: if false;     // bir numara bir kez alınır, değişmez
    }

    // Kişisel hesap profili: YALNIZCA sahibi okur; yalnız kendi numarasıyla bir kez oluşturulur
    match /cuzdan/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
                    && get(/databases/$(database)/documents/hesapNo/$(request.resource.data.hesapNo)).data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Harcamalar: yalnızca sahibi okur/yazar/siler
    match /cuzdanHarcama/{id} {
      allow read, delete: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.tutar is number
                    && request.resource.data.tutar > 0
                    && request.resource.data.tutar <= 100000000;
      allow update: if false;
    }

    // Transferler: yalnızca gönderen ve alıcı okur. Gönderen oluşturur (adlar kayıt defteriyle AYNI olmak zorunda),
    // alıcı yalnızca BİR KEZ "itiraz" işaretleyebilir. Silinemez, başka alan değiştirilemez.
    match /transferler/{id} {
      allow read: if request.auth != null
                  && (resource.data.gonderenUid == request.auth.uid || resource.data.aliciUid == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.gonderenUid == request.auth.uid
        && request.resource.data.aliciUid != request.auth.uid
        && request.resource.data.durum == 'tamam'
        && request.resource.data.tutar is number
        && request.resource.data.tutar > 0
        && request.resource.data.tutar <= 10000000
        && get(/databases/$(database)/documents/hesapNo/$(request.resource.data.gonderenNo)).data.uid == request.auth.uid
        && get(/databases/$(database)/documents/hesapNo/$(request.resource.data.gonderenNo)).data.ad == request.resource.data.gonderenAd
        && get(/databases/$(database)/documents/hesapNo/$(request.resource.data.aliciNo)).data.uid == request.resource.data.aliciUid
        && get(/databases/$(database)/documents/hesapNo/$(request.resource.data.aliciNo)).data.ad == request.resource.data.aliciAd;
      allow update: if request.auth != null
        && resource.data.aliciUid == request.auth.uid
        && resource.data.durum == 'tamam'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['durum','itirazNot','itirazZaman'])
        && request.resource.data.durum == 'itiraz'
        && request.resource.data.itirazNot is string
        && request.resource.data.itirazNot.size() <= 200
        && request.resource.data.itirazZaman == request.time;
      allow delete: if false;
    }
  }
}
