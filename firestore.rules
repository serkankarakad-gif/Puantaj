rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function girisYapmis(){
      return request.auth != null;
    }
    function sahibi(kullaniciId){
      return request.auth != null && request.auth.uid == kullaniciId;
    }

    match /kullanicilar/{kullaniciId} {
      // Ana profil belgesi (ad, ayarlar, yevmiye, şantiyeler, belgeler vb.):
      // "Herkes" ekranı başka kullanıcıların adını/ücret ayarlarını okuyabilmeli,
      // bu yüzden okuma herkese (giriş yapmış) açık — ama SADECE kendi UID'in yazabilir.
      allow read: if girisYapmis();
      allow write: if sahibi(kullaniciId);

      // "Herkes" / kişi karşılaştırma özelliği SADECE bu iki alt koleksiyona bakıyor,
      // o yüzden sadece bunlar herkese açık okunabilir kalıyor.
      match /girdiler/{gunId} {
        allow read: if girisYapmis();
        allow write: if sahibi(kullaniciId);
      }
      match /odemeler/{odemeId} {
        allow read: if girisYapmis();
        allow write: if sahibi(kullaniciId);
      }

      // Geri kalan HER ŞEY tamamen kişisel: borçlar, cüzdan, kredi kartları,
      // masraflar, ekip (yönettiğin işçiler), planlar, fotoğraflar, fişler,
      // dekontlar, notlar, cihaz/bildirim jetonları, kaza kayıtları vb.
      // Bunlara SADECE sahibi okuyup yazabilir — başka hiçbir kullanıcı göremez.
      match /{koleksiyon}/{belgeId} {
        allow read, write: if sahibi(kullaniciId);
      }

      // İleride 3+ seviye derine inen bir alt-alt koleksiyon eklenirse
      // (örn. kullanicilar/x/ekip/y/notlar/z) yine sadece sahibine açık kalsın.
      match /{koleksiyon}/{belgeId}/{altYol=**} {
        allow read, write: if sahibi(kullaniciId);
      }
    }

    // Yukarıdakiler dışında (kullanicilar/** hariç) hiçbir belgeye erişim yok.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
